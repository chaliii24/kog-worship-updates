{
  "name": "kog-worship",
  "private": true,
  "version": "1.1.28",
  "description": "KOG Worship presentation suite",
  "author": "Charles Arradaza",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "test:load": "playwright test -c playwright.load.config.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.22.0",
    "@untitledui/icons": "^0.0.23",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fabric": "^6.9.1",
    "konva": "^10.6.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.4.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-konva": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.kogworship.app",
    "productName": "KOG Worship",
    "artifactName": "KOG.Worship.${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "chaliii24",
      "repo": "kog-worship-updates"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KOG Worship",
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico"
    }
  }
}
